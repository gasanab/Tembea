# Browser-accessible API origin. The client appends /api when it is omitted.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Canonical public origin used for redirects and metadata in deployed environments.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# These public flags control whether the hosted-provider payment action is shown.
# The backend flags and credentials remain authoritative.
NEXT_PUBLIC_PAYMENTS_ENABLED=false
NEXT_PUBLIC_PAYMENT_PROVIDER=flutterwave
